# 金鑰只填本機，不要貼聊天或提交 GitHub。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# demo 是虛構電影，所有回覆都會標明；接上 TMDB 後改成 tmdb。
MOVIE_DATA_MODE=demo
TMDB_READ_ACCESS_TOKEN=
PORT=3002
SQLITE_PATH=./data/movie-bot.sqlite

# Google Maps Platform：啟用 Places API (New)，用於地標／地址與附近影院。
# 未設定時原有電影、場次與票根功能仍可用。
GOOGLE_MAPS_API_KEY=

# 票匣公開 origin；正式部署須與 Caddy HTTPS 網址一致，結尾不要加 /tickets/。
PUBLIC_BASE_URL=http://127.0.0.1:3002
# 尚未建立 LIFF 時留空，LINE 輸入「我的票匣」仍可用短效入口。
# 這是 LINE Login / MINI App 的 Channel ID，不是 Messaging API Channel ID。
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
# LINE Login 的 LIFF 用 liff；LINE MINI App 用 miniapp。
LIFF_APP_TYPE=liff
